{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "0.2.2",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "contextMenus",
    "downloads",
    "notifications",
    "alarms",
    "tabs",
    "webNavigation",
    "webRequest",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "__MSG_extName__" },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
